# Copia este archivo como Backend/.env y completa los valores. Backend/.env no se sube al repo.
# Sin .env, el perfil dev usa PostgreSQL local (localhost:5432, usuario y contraseña "resigest").

# --- Base de datos ---
# Supabase: Project Settings → Database → Connection string → "Session pooler" (puerto 5432).
# No uses el "Transaction pooler" (6543): Flyway necesita una sesión completa.
# Formato JDBC: jdbc:postgresql://<host-del-pooler>:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# En el Session pooler el usuario lleva el id del proyecto: postgres.<id-del-proyecto>
DB_USERNAME=postgres.<id-del-proyecto>
DB_PASSWORD=<contraseña-de-la-base>

# --- Pago en línea con PayU (opcional) ---
# Sin estas variables se usa el sandbox público de PayU (credenciales de prueba de su documentación).
# Solo hay que cambiarlas para usar una cuenta propia de PayU.
# PAYU_MERCHANT_ID=508029
# PAYU_ACCOUNT_ID=512321
# PAYU_API_LOGIN=pRRXKOl8ikMmt9u
# PAYU_API_KEY=4Vj8eK4rloUd272L48hsrarnUA
# URL pública para que PayU avise de los pagos (no funciona con localhost):
# PAYU_URL_CONFIRMACION=https://<backend>/api/pagos/en-linea/confirmacion

# --- Solo producción (perfil prod) ---
# JWT_SECRETO=<cadena aleatoria de al menos 32 caracteres>
# RESIGEST_CLAVE_CREDENCIALES=<otra cadena aleatoria; si cambia, hay que reasignar las contraseñas del personal>
# CORS_ORIGENES=https://<tu-frontend>.vercel.app
